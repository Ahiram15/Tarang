# ==============================================================================
# TARANG — Maritime Oil Spill Intelligence Environment Configuration
# ==============================================================================
# Copy this file to .env and populate with valid credentials before starting services.

# ------------------------------------------------------------------------------
# 1. Satellite Imagery & Discovery APIs
# ------------------------------------------------------------------------------

# Copernicus Data Space Ecosystem (CDSE) — OAuth2 Credentials
# Register at: https://dataspace.copernicus.eu/
CDSE_CLIENT_ID=your_cdse_oauth_client_id_here
CDSE_CLIENT_SECRET=your_cdse_oauth_client_secret_here

# CDSE API Base Endpoints
CDSE_TOKEN_URL=https://identity.dataspace.copernicus.eu/auth/realms/CDSE/protocol/openid-connect/token
CDSE_PROCESS_URL=https://sh.dataspace.copernicus.eu/api/v1/process
CDSE_CATALOG_URL=https://catalogue.dataspace.copernicus.eu/odata/v1/Products
CDSE_STAC_URL=https://stac.dataspace.copernicus.eu/v1/

# AWS Planetary Computer STAC (Landsat 8/9, Sentinel Cross-Verification)
# Documentation: https://planetarycomputer.microsoft.com/docs/quickstarts/reading-stac/
PLANETARY_COMPUTER_STAC_URL=https://planetarycomputer.microsoft.com/api/stac/v1
# Optional subscription key for higher rate limits (free tier works without key)
PLANETARY_COMPUTER_API_KEY=

# ------------------------------------------------------------------------------
# 2. Vessel Tracking & Intelligence APIs
# ------------------------------------------------------------------------------

# AISStream.io — Real-time Live AIS WebSocket Stream
# Obtain free API key at: https://aisstream.io/
AISSTREAM_API_KEY=your_aisstream_api_key_here
AISSTREAM_WS_URL=wss://stream.aisstream.io/v0/stream

# Global Fishing Watch (GFW) — AIS Presence, Identity & SAR Echo Datasets
# Obtain API key at: https://globalfishingwatch.org/our-apis/
GFW_API_KEY=your_gfw_api_key_here
GFW_BASE_URL=https://gateway.api.globalfishingwatch.org/v3

# ------------------------------------------------------------------------------
# 3. MetOcean & Environmental Data APIs
# ------------------------------------------------------------------------------

# Copernicus Marine Service (CMEMS) — Ocean Surface Currents (u/v)
# Register at: https://marine.copernicus.eu/
CMEMS_USERNAME=your_cmems_username_here
CMEMS_PASSWORD=your_cmems_password_here

# ECMWF ERA5 Climate Data Store (CDS) — 10m Wind Velocity (u10/v10)
# Register at: https://cds.climate.copernicus.eu/
CDS_API_KEY=your_ecmwf_cds_api_key_here
CDS_API_URL=https://cds.climate.copernicus.eu/api/v2

# ISRO MOSDAC / Bhoonidhi (Oceansat-3 SCAT-3 Winds & RISAT EOS-04 SAR)
# Register at: https://www.mosdac.gov.in/
MOSDAC_API_KEY=your_mosdac_api_key_here

# ------------------------------------------------------------------------------
# 4. Legal Docket Dispatch & Verification APIs
# ------------------------------------------------------------------------------

# Resend Email API — Cryptographic Enforcement Docket Dispatch
# Obtain API key at: https://resend.com/
RESEND_API_KEY=re_your_resend_api_key_here
RESEND_FROM_EMAIL=enforcement@tarang-intelligence.org
RESEND_WEBHOOK_SECRET=your_resend_webhook_signing_secret_here

# ------------------------------------------------------------------------------
# 5. Pipeline & Default Geo-Location Settings
# ------------------------------------------------------------------------------
DEFAULT_LAT=-20.4381
DEFAULT_LON=57.7446
DEFAULT_DATE=2020-08-06
APP_PORT=8000
ENVIRONMENT=development
